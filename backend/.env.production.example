# Production Environment Configuration
NODE_ENV=production
PORT=4000

# Database Configuration
DATABASE_URL=postgresql://username:password@production-host:5432/gadgethub?schema=public

# Redis Configuration
REDIS_URL=redis://production-host:6379

# Security
JWT_SECRET=your-production-jwt-secret-min-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Admin Account
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# API Configuration
APP_BASE_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com
DOMAIN=api.yourdomain.com
PUBLIC_API_URL=https://api.yourdomain.com

# AI Services
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash

# Email Configuration
EMAIL_ENABLED=true
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=noreply@yourdomain.com

# SMS/WhatsApp Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_SMS_FROM=+1234567890
TWILIO_WHATSAPP_FROM=+1234567890
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid

# Push Notifications
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@yourdomain.com

# File Storage (S3)
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key

# Alternative: Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Payment Gateway
PAYNOW_INTEGRATION_ID=your-paynow-integration-id
PAYNOW_INTEGRATION_KEY=your-paynow-integration-key

# Webhook Security
WEBHOOK_SECRET=your-webhook-secret

# Monitoring
METRICS_TOKEN=your-metrics-token
LOG_LEVEL=info